---
import { categories } from "../lib/categories";
---

<header class="site-header">
  <a class="brand" href="/" aria-label="JadiCuan, beranda">
    <img class="brand-mark" src="/jadicuan-logo.png" alt="" />
    <span class="brand-copy">
      <strong>JadiCuan</strong>
      <small>@jadicuan.pub</small>
    </span>
  </a>
  <nav class="main-nav" aria-label="Navigasi utama">
    {categories.map((category) => (
      <a href={`/kategori/${category.slug}/`}>{category.title}</a>
    ))}
    <a class="search-link" href="/cari/" aria-label="Cari artikel">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <circle cx="10.8" cy="10.8" r="6.8" />
        <path d="m16 16 4.2 4.2" />
      </svg>
      <span>Cari</span>
    </a>
  </nav>
</header>
