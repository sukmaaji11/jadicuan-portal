---
// Halaman aktivasi Versi Lengkap Kalkulator Modal (/kalkulator-modal/aktivasi/).
// Tautan halaman ini dikirim otomatis oleh Scalev setelah pembeli order. Pembeli minta kode lewat
// WhatsApp, menempelkannya di sini, lalu langsung mulai menghitung. Kode diperiksa di browser
// (kunci publik); tidak ada data yang dikirim ke server.
import SiteLayout from "../../components/SiteLayout.astro";
import MetaPixel from "../../components/MetaPixel.astro";
import { links } from "../../config/links";

const pesanWa = "Halo JadiCuan, saya sudah order Versi Lengkap Kalkulator Modal.\nNama: \nNomor pesanan Scalev: \nMohon kode aktivasinya. Terima kasih.";
const urlWa = `${links.whatsapp}?text=${encodeURIComponent(pesanWa)}`;
---

<SiteLayout
  title="Aktivasi Versi Lengkap Kalkulator Modal — JadiCuan"
  description="Aktifkan Versi Lengkap Kalkulator Modal & Balik Modal JadiCuan dengan kode aktivasi."
  canonicalPath="/kalkulator-modal/aktivasi"
  noIndex
>
  <!-- Tautan lama ...#kode=... : pindahkan kode ke sessionStorage SEBELUM Meta Pixel dimuat
       (Pixel mencatat alamat halaman), lalu bersihkan alamatnya. -->
  <script is:inline>
    (function () {
      var m = /^#kode=([0-9A-Za-z-]{20,200})$/.exec(location.hash);
      if (!m) return;
      try { sessionStorage.setItem("jadicuan:kalkulator-modal:kode-tautan", m[1]); } catch (e) {}
      history.replaceState(null, "", location.pathname + location.search);
    })();
  </script>
  <section class="hpp-page modal-page aktivasi-page">
    <header class="hpp-intro modal-intro aktivasi-intro">
      <span class="eyebrow"><span class="eyebrow-dot"></span> Versi Lengkap Kalkulator Modal</span>
      <h1>Aktifkan versi lengkap.</h1>
      <p>Terima kasih sudah membeli. Tinggal dua langkah lagi.</p>
    </header>

    <!-- Sudah aktif di perangkat ini -->
    <section class="hpp-panel aktivasi-done" id="aktivasi-sudah" aria-labelledby="aktivasi-sudah-title" hidden>
      <div class="aktivasi-head">
        <span class="aktivasi-check" aria-hidden="true">✓</span>
        <h2 id="aktivasi-sudah-title" tabindex="-1">Versi lengkap aktif</h2>
      </div>
      <p>Nomor seri <strong class="aktivasi-serial" id="aktivasi-seri"></strong></p>
      <ul class="aktivasi-fitur">
        <li>3 skenario: sepi, normal, ramai</li>
        <li>Simpan sampai 20 usaha</li>
        <li>Unduh ringkasan PDF</li>
      </ul>
      <a class="button button-primary aktivasi-cta" href="/kalkulator-modal/">Mulai hitung <span aria-hidden="true">→</span></a>
      <p class="aktivasi-note">Fitur tambahan ada di halaman hasil. Ganti HP? Tempel kode yang sama lagi.</p>
      <button class="modal-text-button" type="button" id="aktivasi-ganti">Pakai kode lain</button>
    </section>

    <!-- Belum aktif -->
    <div class="aktivasi-steps" id="aktivasi-form">
      <section class="hpp-panel aktivasi-step" aria-labelledby="aktivasi-1">
        <div class="aktivasi-head">
          <span class="aktivasi-num" aria-hidden="true">1</span>
          <h2 id="aktivasi-1">Minta kode</h2>
        </div>
        <p>Kirim pesan ke WhatsApp kami. Isi nama dan nomor pesanan Scalev, lalu kami balas dengan kodenya.</p>
        <a class="button button-primary aktivasi-wa" id="aktivasi-wa" href={urlWa} target="_blank" rel="noopener noreferrer">Minta kode via WhatsApp <span aria-hidden="true">↗</span></a>
      </section>

      <section class="hpp-panel aktivasi-step" aria-labelledby="aktivasi-2">
        <div class="aktivasi-head">
          <span class="aktivasi-num" aria-hidden="true">2</span>
          <h2 id="aktivasi-2">Tempel kode</h2>
        </div>
        <form class="aktivasi-form" id="aktivasi-isi" novalidate>
          <label for="aktivasi-kode">Salin kode dari pesan kami, lalu tempel di sini.</label>
          <textarea id="aktivasi-kode" rows="3" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABCD-EFGH-…"></textarea>
          <button class="button button-primary" type="submit" id="aktivasi-tombol">Aktifkan</button>
          <p class="aktivasi-status" id="aktivasi-status" role="status"></p>
        </form>
      </section>
    </div>

    <p class="aktivasi-help">Ada kendala? <a href={links.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp 0821-3301-250</a></p>
  </section>
  <MetaPixel tool="modal" />
</SiteLayout>

<script>
  import { pasangAktivasi } from "../../lib/aktivasi-ui";
  pasangAktivasi();
</script>
