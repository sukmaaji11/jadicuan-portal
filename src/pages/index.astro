---
import ArticleCard from "../components/ArticleCard.astro";
import SiteLayout from "../components/SiteLayout.astro";
import { categories } from "../lib/categories";
import { getLatestArticles } from "../lib/sanity";
import { links } from "../config/links";

const articles = await getLatestArticles(7);
const featured = articles.find((article) => article.featured) ?? articles[0];
const latest = articles.filter((article) => article._id !== featured?._id);
---

<SiteLayout>
  <section class="hero page-width">
    <div class="hero-copy">
      <span class="eyebrow"><span class="eyebrow-dot"></span> Cerita • Inspirasi • Peluang</span>
      <h1>Ide baik layak punya <span>panggung.</span></h1>
      <p>Kami mengumpulkan cerita bisnis, inspirasi, wawasan digital, dan peluang yang bisa membawa kita melangkah lebih jauh.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#artikel">Jelajahi artikel <span aria-hidden="true">↘</span></a>
        <a class="button button-secondary" href="#tentang">Kenali JadiCuan <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-note">Dibuat untuk <strong>curious minds.</strong></div>
      {featured ? (
        <ArticleCard article={featured} featured />
      ) : (
        <div class="editorial-card">
          <div class="editorial-card-top">
            <img class="brand-mark brand-mark-small" src="/jadicuan-logo.png" alt="" />
            <strong>JadiCuan</strong>
            <span class="editorial-badge">RUANG IDE</span>
          </div>
          <div class="editorial-art" aria-hidden="true">
            <span class="art-spark art-spark-one">✳</span>
            <span class="art-ring"></span>
            <div class="art-paper">
              <span class="art-line art-line-blue"></span>
              <span class="art-line art-line-short"></span>
              <span class="art-line"></span>
            </div>
            <span class="art-spark art-spark-two">✦</span>
          </div>
          <h2>Cerita baik dimulai dari rasa ingin tahu.</h2>
          <p>Temukan ide, pengalaman, dan peluang baru di sini.</p>
          <div class="editorial-progress" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
      )}
    </div>
  </section>

  <section class="tools-section page-width" id="alat" aria-labelledby="alat-judul">
    <div class="section-heading">
      <div>
        <span class="section-kicker">Alat gratis untuk usaha</span>
        <h2 id="alat-judul">Hitung dulu, baru melangkah.</h2>
      </div>
      <p class="tools-note">Langsung pakai, tanpa daftar. Angka yang kamu isi tetap di perangkatmu.</p>
    </div>
    <div class="tool-grid">
      <a class="tool-card tool-card-hpp" href="/kalkulator-hpp/">
        <span class="tool-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11h18a9 9 0 0 1-18 0Z" />
            <path d="M7 20h10" />
            <path d="M9 7c0-1.5 1-1.5 1-3M13 7c0-1.5 1-1.5 1-3" />
          </svg>
        </span>
        <span class="tool-body">
          <span class="tool-label">Per porsi menu</span>
          <strong class="tool-title">Kalkulator HPP</strong>
          <span class="tool-text">Hitung modal bahan dan biaya tambahan untuk satu porsi, lalu lihat berapa persen dari harga jual.</span>
          <span class="tool-cta">Hitung HPP <span aria-hidden="true">→</span></span>
        </span>
      </a>
      <a class="tool-card tool-card-modal" href="/kalkulator-modal/">
        <span class="tool-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 20h18" />
            <path d="M6 16v-3M10.5 16V10M15 16V12" />
            <path d="m5 9 4.5-4 4 3L20 3" />
            <path d="M16 3h4v4" />
          </svg>
        </span>
        <span class="tool-body">
          <span class="tool-label">Untuk usaha baru</span>
          <strong class="tool-title">Kalkulator Modal &amp; Balik Modal</strong>
          <span class="tool-text">Perkirakan total modal awal, titik impas harian, dan kira-kira berapa bulan sampai modal kembali.</span>
          <span class="tool-cta">Hitung modal <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </div>
  </section>

  <section class="content-section page-width" id="artikel">
    <div class="section-heading">
      <div>
        <span class="section-kicker">Dari ruang redaksi</span>
        <h2>Ide untuk dibawa lebih jauh.</h2>
      </div>
      <a class="text-link" href="/cari/">Cari artikel <span aria-hidden="true">⌕</span></a>
    </div>
    {latest.length > 0 ? (
      <div class="article-grid">
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <div class="empty-editorial">
        <span class="empty-icon" aria-hidden="true">✦</span>
        <div>
          <h3>Bab pertama segera dimulai.</h3>
          <p>Artikel terbaru JadiCuan akan hadir di sini. Sementara itu, jelajahi tiga topik yang kami angkat.</p>
        </div>
      </div>
    )}
  </section>

  <section class="direction-section" id="tentang">
    <div class="page-width">
      <div class="direction-intro">
        <div>
          <span class="section-kicker">Arah JadiCuan</span>
          <h2>Bukan sekadar mencari cuan.</h2>
        </div>
        <p>Kami ingin membantu kamu memahami peluang, mengambil keputusan, dan mengembangkan sesuatu lewat cerita dan informasi yang relevan.</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={`/kategori/${category.slug}/`}>
            <span class="category-icon" aria-hidden="true">{category.icon}</span>
            <h3>{category.title}</h3>
            <p>{category.description}</p>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="connect-card">
        <div>
          <span class="section-kicker">Tetap terhubung</span>
          <h3>Ide baik selalu punya cerita lanjutan.</h3>
          <p>Ikuti kabar terbaru JadiCuan dan temukan lebih banyak inspirasi melalui Instagram.</p>
        </div>
        <a class="button button-primary" href={links.instagram} target="_blank" rel="noreferrer">Ikuti JadiCuan <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "JadiCuan",
      url: "https://jadicuan.co.id",
      logo: "https://jadicuan.co.id/jadicuan-logo.png",
      sameAs: [links.instagram],
    }).replace(/</g, "\\u003c")}
  />
</SiteLayout>
